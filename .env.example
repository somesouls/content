# ==== LLM (teks) ====
# provider: gemini | azure | ollama | fallback
LLM_PROVIDER=gemini
# Gemini via Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Azure OpenAI (opsional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
# Ollama lokal (opsional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==== Voice / TTS ====
# provider: elevenlabs | xtts
VOICE_PROVIDER=elevenlabs
# ElevenLabs: https://elevenlabs.io (Profile -> API Key, Voice -> Voice ID)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ==== Posting ====
POST_TIME=19:00
TIMEZONE=Asia/Jakarta
# tiktok provider: manual | api
TIKTOK_PROVIDER=manual
TIKTOK_ACCESS_TOKEN=

# ==== Server ====
HOST=0.0.0.0
PORT=8000
REVIEW_REQUIRED=true
