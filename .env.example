# ==== LLM (teks) ====
# provider: gemini | azure | ollama | fallback
LLM_PROVIDER=gemini
# Gemini via Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Azure OpenAI (opsional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
# Ollama lokal (opsional, jalan di GPU-mu)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==== Voice / TTS ====
# provider: elevenlabs | xtts
# elevenlabs = kualitas tinggi (kuota free kecil, harian kemungkinan perlu bayar)
# xtts = GRATIS, jalan di GPU-mu, bisa clone suaramu dari assets/voice/ref.wav
VOICE_PROVIDER=xtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ==== Images (background AI) ====
# provider: pollinations (GRATIS, tanpa key) | gemini | none
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=imagen-3.0-generate-002

# ==== Subtitles (auto, Whisper) ====
SUBTITLES_ENABLED=true
# model whisper: tiny | base | small | medium | large-v3 (makin besar makin akurat & berat)
WHISPER_MODEL=small

# ==== Format konten harian ====
# carousel | voiceover
DAILY_FORMAT=carousel

# ==== Posting ====
POST_TIME=19:00
TIMEZONE=Asia/Jakarta
# tiktok provider: manual | api
TIKTOK_PROVIDER=manual
TIKTOK_ACCESS_TOKEN=
# privacy: SELF_ONLY (wajib sebelum app diaudit) | PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR
TIKTOK_PRIVACY=SELF_ONLY
# domain publik utk carousel foto (opsional; kosongkan -> slide diubah jadi video)
PUBLIC_BASE_URL=

# ==== Server ====
HOST=0.0.0.0
PORT=8000
REVIEW_REQUIRED=true
